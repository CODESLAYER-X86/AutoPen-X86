# Local development environment — copy values into your own .env and adjust.
# NOTE: .env is gitignored. Never commit real credentials.

# --- Application ---
NODE_ENV=development
APP_NAME=Aegis Platform
APP_PORT=4000
APP_LOG_LEVEL=info

# --- Database (embedded PostgreSQL managed by scripts/db/*.ts, port 5433) ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/aegis
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/aegis_test
DATABASE_POOL_MAX=10

# --- Authentication ---
AUTH_SESSION_TTL_HOURS=24
AUTH_RATE_LIMIT_MAX=20

# --- LLM providers / model roles (changed via config, never in code) ---
STRATEGIC_MODEL_PROVIDER=mock
STRATEGIC_MODEL_ID=mock-strategic-1
TACTICAL_MODEL_PROVIDER=mock
TACTICAL_MODEL_ID=mock-tactical-1
MODEL_REQUEST_TIMEOUT_MS=60000
# The Google API key is read directly from the environment by the provider and
# is never copied into the config object, the database, or logs:
# GOOGLE_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# --- Queue abstraction (memory is the Part 1 provider) ---
QUEUE_PROVIDER=memory

# --- Object storage (local filesystem in Part 1) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/artifacts

# --- Secret store ---
SECRET_STORE_PATH=./data/secrets/secrets.json
# Base64-encoded 32-byte master key. If empty, a development key is generated
# at ./data/secrets/master.key (gitignored).
SECRET_STORE_MASTER_KEY=

# --- Browser automation ---
BROWSER_ENABLED=false

# --- HTTP tooling defaults ---
HTTP_TIMEOUT_MS=15000
HTTP_MAX_BODY_BYTES=1048576

# --- Security ---
CORS_ORIGINS=http://localhost:5173
DESTRUCTIVE_ACTIONS_ALLOWED_DEFAULT=false

# --- Feature flags (false = subsystem explicitly not implemented yet) ---
FEATURE_TOOLS_HTTP=true
FEATURE_TOOLS_BROWSER=true
# Part 5 implements the knowledge subsystem (hybrid retrieval, research).
FEATURE_KNOWLEDGE_SEARCH=true
FEATURE_REPORTING=true

# --- Agent Operating System (Part 2) ---
# Loop bounds (anti-runaway, spec Part 2 §30/§50).
AGENT_MAX_CYCLES=40
AGENT_MAX_IDLE_CYCLES=3
AGENT_IDLE_BACKOFF_MS=150
AGENT_MAX_WAIT_MS=5000
AGENT_MAX_CONCURRENT_TASKS=2
# Worker runtime bounds (§36): workers cannot raise their own limits.
AGENT_WORKER_MAX_TURNS=24
AGENT_WORKER_MAX_OUTPUT_TOKENS=2048

# Provider-independent quota limits (§37): all numbers configurable.
AGENT_QUOTA_RPM=60
AGENT_QUOTA_INPUT_TPM=120000
AGENT_QUOTA_OUTPUT_TPM=16000
AGENT_QUOTA_RPD=2000

# Token budgets per purpose (§38): leader gets larger context, fewer calls;
# workers get small contexts, many focused calls.
AGENT_TOKEN_BUDGET_LEADER=400000
AGENT_TOKEN_BUDGET_WORKER=1200000
AGENT_TOKEN_BUDGET_KNOWLEDGE=100000
AGENT_TOKEN_BUDGET_SUMMARIZATION=50000
AGENT_TOKEN_BUDGET_VERIFICATION=150000

# Engagement resource budget defaults (§66). unset = no per-engagement cap.
# AGENT_ENGAGEMENT_MAX_MODEL_CALLS=2000
# AGENT_ENGAGEMENT_MAX_MODEL_TOKENS=5000000

# --- Security Knowledge & Web Research (Part 5) ---
# Semantic chunking targets (spec Part 5 §11): chunks 300-800 tokens.
KNOWLEDGE_CHUNK_MIN_TOKENS=300
KNOWLEDGE_CHUNK_MAX_TOKENS=800
# Packet token budgets (§62-§63): leader <= 2500, worker <= 1200.
KNOWLEDGE_MAX_PACKET_TOKENS=2500
KNOWLEDGE_WORKER_PACKET_TOKENS=1200
# Query cache TTL in ms (§65).
KNOWLEDGE_CACHE_TTL_MS=300000
# Fetch limits (§27): bounded reads with explicit truncation.
KNOWLEDGE_FETCH_MAX_PAGE_BYTES=2097152
KNOWLEDGE_FETCH_MAX_REDIRECTS=5
KNOWLEDGE_FETCH_TIMEOUT_MS=15000
KNOWLEDGE_SYNC_MAX_PAGES=25
KNOWLEDGE_FETCH_MAX_CONCURRENCY=2
# Rate limits + daily budget (§82).
KNOWLEDGE_RATE_PER_SOURCE_PER_MINUTE=10
KNOWLEDGE_DAILY_FETCH_BUDGET=500
# Research budgets (§83): searches/pages/bytes/time/tokens per task.
KNOWLEDGE_RESEARCH_MAX_SEARCHES=3
KNOWLEDGE_RESEARCH_MAX_PAGES=5
KNOWLEDGE_RESEARCH_MAX_BYTES=5242880
KNOWLEDGE_RESEARCH_MAX_TIME_MS=60000
KNOWLEDGE_RESEARCH_MAX_TOKENS=6000
# Embedding provider (§14, §107): hash (offline, deterministic) | google | none.
KNOWLEDGE_EMBEDDING_PROVIDER=hash
KNOWLEDGE_EMBEDDING_MODEL=aegis-hash-256-v1
KNOWLEDGE_EMBEDDING_DIMENSION=256
# Hybrid ranking weights (§69); duplicate penalty subtracts (§109).
KNOWLEDGE_SEMANTIC_WEIGHT=1.0
KNOWLEDGE_KEYWORD_WEIGHT=1.0
KNOWLEDGE_TRUST_WEIGHT=0.5
KNOWLEDGE_FRESHNESS_WEIGHT=0.3
KNOWLEDGE_CONTEXT_WEIGHT=0.4
KNOWLEDGE_SPECIFICITY_WEIGHT=0.2
KNOWLEDGE_DUPLICATE_PENALTY=0.15
# Lab policy only: allow loopback knowledge fetches (SSRF default: deny).
KNOWLEDGE_ALLOW_LOOPBACK=false
# AGENT_ENGAGEMENT_MAX_NETWORK_REQUESTS=10000
# AGENT_ENGAGEMENT_MAX_DURATION_SECONDS=14400

# Part 4: security reasoning engine (default on; 501s honestly when off).
FEATURE_SECURITY_REASONING=true

# Reasoning resource limits (spec Part 4 §113) — caps against pathological
# targets: derived graph size, signal volume, comparison bytes.
REASONING_MAX_GRAPH_NODES=5000
REASONING_MAX_GRAPH_EDGES=20000
REASONING_MAX_SIGNALS=5000
REASONING_MAX_PARAMETERS=10000
REASONING_MAX_ENDPOINTS=5000
REASONING_MAX_OBJECTS=2000
REASONING_MAX_EXAMPLE_VALUES=8
REASONING_MAX_COMPARISON_BYTES=65536
REASONING_MAX_MUTATION_CANDIDATES=64

# --- Part 6: autonomous pentest & CTF engine --------------------------------
# Master feature flag (requires FEATURE_SECURITY_REASONING).
FEATURE_AUTONOMOUS_ENGINE=true

# Replan budget before a §50 stop, fallback tick cadence (§8).
AUTONOMOUS_MAX_REPLANS=6
AUTONOMOUS_MAINTENANCE_INTERVAL_MS=2500

# Bounded recon plan (§9/§11): max tasks + known-path probes per target.
AUTONOMOUS_RECON_MAX_TASKS=12
AUTONOMOUS_RECON_MAX_PATHS_PER_TARGET=8

# §38 incremental candidate batches + §65 branch/hypothesis budgets.
AUTONOMOUS_CANDIDATE_BATCH=6
AUTONOMOUS_BRANCH_LIMIT=8
AUTONOMOUS_HYPOTHESIS_LIMIT=12

# Task leases (§55): duration + sweep interval.
AUTONOMOUS_TASK_LEASE_MS=120000
AUTONOMOUS_LEASE_SWEEP_INTERVAL_MS=15000

# §50 stop thresholds (diminishing returns window + repeated failures).
AUTONOMOUS_STOP_MIN_TESTS=3
AUTONOMOUS_STOP_MIN_INFORMATION_GAIN=0.05
AUTONOMOUS_STOP_MAX_CONSECUTIVE_FAILURES=4

# §31 flag patterns — SEMICOLON-separated regexes (bodies contain commas).
AUTONOMOUS_FLAG_PATTERNS=flag\{[A-Za-z0-9_-]{4,128}\};CTF\{[A-Za-z0-9_-]{4,128}\};aegis\{[A-Za-z0-9_-]{4,128}\}

# §78 phase budget allocation (recon + testing shares; verification = rest).
AUTONOMOUS_BUDGET_RECON_SHARE=0.4
AUTONOMOUS_BUDGET_TESTING_SHARE=0.45

# Timeline response bound + §40 knowledge-query anti-loop.
AUTONOMOUS_TIMELINE_LIMIT=200
AUTONOMOUS_MAX_KNOWLEDGE_QUERY_REPEATS=2

# ---------------------------------------------------------------------------
# Part 7 — Verification, Reporting & Evaluation
# ---------------------------------------------------------------------------
FEATURE_EVALUATION=true
REPORTING_CONFIDENCE_HIGH_THRESHOLD=0.75
REPORTING_CONFIDENCE_MEDIUM_THRESHOLD=0.45
REPORTING_HIGH_RISK_CONFIDENCE_THRESHOLD=0.8
REPORTING_MAX_FINDINGS_PER_REPORT=500
REPORTING_MAX_EVIDENCE_PER_FINDING=6
REPORTING_EVIDENCE_EXCERPT_BYTES=600
REPORTING_REQUIRE_VERIFIED_FOR_REPORT=true
EVALUATION_MAX_SCENARIOS_PER_RUN=32
EVALUATION_REGRESSION_PRECISION_DROP_PCT=5
EVALUATION_REGRESSION_RECALL_DROP_PCT=10
EVALUATION_REGRESSION_FPR_RISE_PCT=3
